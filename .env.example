# Get your API key: https://app.nansen.ai/auth/agent-setup
NANSEN_API_KEY=
# Force demo mode (no real API calls): 1 = yes, 0 = no. Empty = auto (demo unless key set)
DEMO_MODE=
# Poll intervals (seconds) — larger = slower credit burn
POLL_POSITIONS_SEC=180
POLL_TRADES_SEC=180
POLL_SMART_SEC=300
POLL_LEADERBOARD_SEC=1800
