# Get your API key: https://app.nansen.ai/auth/agent-setup
NANSEN_API_KEY=
# Force demo mode (no real API calls): 1 = yes, 0 = no. Empty = auto (demo unless key set)
DEMO_MODE=
# Poll intervals (seconds) — larger = slower credit burn
POLL_POSITIONS_SEC=180
POLL_TRADES_SEC=180
POLL_SMART_SEC=300
POLL_LEADERBOARD_SEC=1800
# Auto-pause the engine at this many API calls (0 = never). Set e.g. 1050 for the buildathon's 1,000-call rule
AUTO_PAUSE_CALLS=1050
# Required when deployed publicly: dashboard asks for this token before any API access
ACCESS_TOKEN=
